<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.padhelper.fastcts">
    <!-- Optional alerts (settings -> 알림): missing device-log access and a new version. Requested on first launch
         or when enabling an alert in settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates (normal permission): only for the opt-in camera-island form of the device-log notice. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Experimental overlay mode only (off by default): touch area and background starts without accessibility. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Development permission granted once over ADB; each new log session still needs Android's own confirmation. -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- Settings-screen update check only (AppUpdate: the button, or once per open if left on): GitHub release metadata/APK download and Android's install confirmation. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <package android:name="com.android.systemui" />
        <package android:name="com.android.launcher" />
        <package android:name="com.heytap.speechassist" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <!-- Circle to Search fallback only: the direct call is refused and MiCTS is installed. -->
        <package android:name="com.parallelc.micts" />
        <!-- 고급 → 앱 설치 프로그램 광고 제거: shows whether this page is frozen. -->
        <package android:name="com.oplus.appdetail" />
        <!-- 개발자 옵션 빠른 접근: waits until Settings makes its developer page available again. -->
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false" android:theme="@style/TransparentTrigger">
        <receiver android:name=".BootReceiver" android:exported="false" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".AppUpdate$Result" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false"
            android:excludeFromRecents="true" android:taskAffinity="" />
        <!-- App drawer icon: shown by default; "앱 서랍에 표시" hides it (PackageManager component state). A tap opens
             Circle to Search only (MainActivity ignores every extra on this path); settings only via the long-press shortcut. -->
        <activity android:name=".DrawerActivity" android:exported="false"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="" />
        <activity-alias android:name=".DrawerLaunch" android:targetActivity=".DrawerActivity"
            android:enabled="true" android:exported="true" android:label="@string/app_name"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity android:name=".LogAccessActivity" android:exported="false"
            android:excludeFromRecents="true" android:taskAffinity="" android:launchMode="singleTask" />
        <activity android:name=".SetupCommandActivity" android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".TouchAppsActivity" android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />
        <activity android:name=".SetupActivity" android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service android:name=".BarService" android:exported="true" android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/bottom_search_accessibility" />
        </service>
        <service android:name=".BarTile" android:exported="true"
            android:label="스위치" android:icon="@android:drawable/ic_menu_search"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service android:name=".LaunchTile$Search" android:exported="true"
            android:label="검색" android:icon="@drawable/ic_tile_search"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service android:name=".DimTile" android:exported="true"
            android:label="딥 다크 모드" android:icon="@drawable/ic_tile_dim"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service android:name=".LaunchTile$Assistant" android:exported="true"
            android:label="어시스턴트" android:icon="@drawable/ic_tile_assistant"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Optional update alert: the 24 h check, run only by the system job scheduler while that alert is on. -->
        <service android:name=".Alerts$UpdateJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
